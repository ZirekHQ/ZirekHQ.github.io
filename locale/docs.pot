#. type: Title =
#: .translation-src/pact-avro-plugin/docs/modules/ROOT/pages/logging.adoc:1
#, no-wrap
msgid "Logging"
msgstr ""

#. type: Plain text
#: .translation-src/pact-avro-plugin/docs/modules/ROOT/pages/logging.adoc:4
msgid "The plugin uses https://logback.qos.ch[Logback] to log to"
msgstr ""

#. type: Plain text
#: .translation-src/pact-avro-plugin/docs/modules/ROOT/pages/logging.adoc:6
msgid "standard output"
msgstr ""

#. type: Plain text
#: .translation-src/pact-avro-plugin/docs/modules/ROOT/pages/logging.adoc:7
msgid "`log/plugin.log` file in in the plugin directory."
msgstr ""

#. type: Plain text
#: .translation-src/pact-avro-plugin/docs/modules/ROOT/pages/logging.adoc:9
msgid ""
"The default log level is set to `ERROR` level and can be changed by the "
"`LOG_LEVEL` environment variable that is passed into the plugin process "
"(this should be set by the framework calling it)."
msgstr ""

#. type: Plain text
#: .translation-src/pact-avro-plugin/docs/modules/ROOT/pages/logging.adoc:10
msgid ""
"The default file logging is set to roll daily or whenever the file size "
"reaches 50MB. Logger will keep 30 days' worth of logging history"
msgstr ""
