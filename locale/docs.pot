msgid "End-to-end testing for NVDA add-ons, against a real NVDA, in CI."
msgstr ""

#. type: Plain text
#: .translation-src/nvda-addon-testkit/docs/modules/ROOT/pages/index.adoc:8
msgid ""
"Your add-on's logic can be unit-tested with stubs. What cannot be stubbed is "
"whether it installs, registers, and behaves inside NVDA itself. This kit "
"provisions a disposable portable NVDA, installs your add-on into it, and "
"lets pytest drive it."
msgstr ""

#. type: delimited block -
#: .translation-src/nvda-addon-testkit/docs/modules/ROOT/pages/index.adoc:16
#, no-wrap
msgid ""
"def test_my_addon_announces_itself(nvda, addon_under_test, "
"assert_no_unexpected_errors):\n"
"    before = nvda.speech.index()\n"
"    nvda.keys.press(\"NVDA+shift+m\")\n"
"    assert \"my add-on is ready\" in nvda.speech.wait_for(\"ready\", "
"timeout=10, since=before).text\n"
"    assert_no_unexpected_errors(nvda)\n"
msgstr ""

#. type: Plain text
#: .translation-src/nvda-addon-testkit/docs/modules/ROOT/pages/index.adoc:19
msgid ""
"See xref:example-project.adoc[] for this same pattern applied to a real, "
"working add-on."
msgstr ""

